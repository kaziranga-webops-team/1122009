# ═══════════════════════════════════════════════════════════════════════════
#  Kaziranga House — environment configuration
#  Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the
#  browser; everything else is server-only.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Google Sheets (server-side only; proxied via /api/*) ────────────
# Published-CSV URLs for each sheet. If unset, the app uses the built-in
# published defaults in lib/sheets.ts.
SHEET_EPISODES_URL=
SHEET_EVENTS_URL=
SHEET_AROHAN_URL=
SHEET_GALLERY_URL=
SHEET_COUNCIL_URL=
SHEET_MEETUPS_URL=

# ─── Firebase client — event portal project (REQUIRED) ───────────────
# Powers Google sign-in and Cloud Firestore for /dashboard, /admin and
# /super-admin. Firebase console → Project settings → Your apps → SDK config.
# If API_KEY, PROJECT_ID or APP_ID is missing the whole portal silently falls
# back to mock mode (see lib/firebase.ts), so these must be set in Vercel too.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Only set this if the portal project also hosts the gallery "likes" Realtime
# Database. When set, RTDB uses this project instead of the legacy one below.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ─── Firebase Admin SDK — server-only (REQUIRED for the portal) ──────
# Without these, adminDb/adminAuth are null and every portal API route is
# inert: /api/seed, /api/auth/allowed-check, /api/auth/request-access,
# /api/admin/export-csv, /api/super-admin/users/role, /api/team/invite.
# Firebase console → Project settings → Service accounts → Generate new
# private key. Use EITHER the single JSON blob (raw or base64 — easiest on
# Vercel) OR the three individual fields.
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Legacy Realtime Database — gallery likes (optional) ─────────────
# The /gallery like counts live in the original kaziranga-now project, not in
# the portal project. These default to that project in lib/firebase.ts; only
# set them to move the likes data elsewhere.
NEXT_PUBLIC_LEGACY_RTDB_API_KEY=
NEXT_PUBLIC_LEGACY_RTDB_AUTH_DOMAIN=
NEXT_PUBLIC_LEGACY_RTDB_DATABASE_URL=
NEXT_PUBLIC_LEGACY_RTDB_PROJECT_ID=
NEXT_PUBLIC_LEGACY_RTDB_STORAGE_BUCKET=
NEXT_PUBLIC_LEGACY_RTDB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_LEGACY_RTDB_APP_ID=

# ─── Supabase — public content database ──────────────────────────────
# Replaces the Google Sheets above. Project Settings → API in the Supabase
# dashboard. The URL is public; the service-role key is NOT — it bypasses
# every row-level policy, so it must never carry a NEXT_PUBLIC_ prefix and
# must never be imported from a file a client component can reach.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if the browser ever queries Postgres directly (live search,
# realtime). In the current design every read goes through a cached route
# handler on the server, so you can leave this unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Cloudinary — images ─────────────────────────────────────────────
# Cloud name is public (it appears in every image URL). The key and secret
# are server-only and are used to sign uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Portal mode toggle ──────────────────────────────────────────────
# "true" runs the portal on in-memory mock data with seeded users and no
# Firebase at all. Keep "false" for real use.
NEXT_PUBLIC_USE_MOCK_FIREBASE=false
